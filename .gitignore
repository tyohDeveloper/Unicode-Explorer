# dependencies
node_modules/

# build outputs (Unicode.html at the root is committed on purpose; see docs/PLAN.md D-9)
dist/
tmp/
*.tsbuildinfo
test-results/
playwright-report/
coverage/

# font cache (binaries are fetched by manifest, never committed)
fonts/cache/

# editors and OS
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db

# secrets
.env*
!.env.example

# generated at build time from fonts/standard (tools/fonts/embeddedFontsCss.ts)
.generated/

# sidecar font packs are release assets built by tools/fonts/buildPacks.ts, never committed (ADR-0001)
unicode-fonts/
