{
  "name": "unicode-explorer",
  "version": "1.0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Offline, single-file Unicode character explorer. No network, no storage.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyohDeveloper/Unicode-Explorer.git"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "check:standards": "node scripts/check-standards.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "build:bundle": "tsx tools/build/assemble.ts",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:regenerated": "node scripts/verify-regenerated.mjs",
    "build": "npm run check && npm run check:standards && npm run test:run && npm run build:bundle && npm run verify:build",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.5",
    "lz-string": "1.5.0",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
