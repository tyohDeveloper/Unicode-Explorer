{
  "name": "unicode-explorer",
  "version": "2.3.2.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Offline, single-file Unicode character explorer. No network, no storage.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyohDeveloper/Unicode-Explorer.git"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5000",
    "preview": "vite preview --host 0.0.0.0 --port 5000",
    "check": "tsc --noEmit",
    "check:standards": "node scripts/check-standards.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "generate:data": "tsx tools/ucd/generate.ts",
    "generate:fonts-css": "tsx tools/fonts/embeddedFontsCss.ts",
    "fetch:fonts": "tsx tools/fonts/fetchFonts.ts",
    "build:packs": "tsx tools/fonts/buildPacks.ts",
    "build:bundle": "npm run generate:fonts-css && vite build && node scripts/minify-artifact.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:regenerated": "node scripts/verify-regenerated.mjs",
    "build": "npm run check && npm run check:standards && npm run test:run && npm run build:bundle && npm run verify:build",
    "release": "node scripts/release.mjs",
    "report:gaps": "tsx tools/fonts/reportGaps.ts",
    "plan:outline": "tsx tools/fonts/planOutlinePacks.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.10.5",
    "@types/wawoff2": "^1.0.2",
    "fflate": "^0.8.3",
    "fontkit": "^2.0.4",
    "html-minifier-terser": "^7.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11",
    "wawoff2": "^2.0.1"
  }
}
